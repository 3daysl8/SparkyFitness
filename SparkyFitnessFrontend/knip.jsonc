{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": ["src/main.tsx", "src/tests/**/*.{ts,tsx}"],
  "project": ["src/**/*.{ts,tsx}"],
  "rules": {
    "exports": "warn",
    "types": "off",
    "files": "warn",
    "dependencies": "off",
    "unlisted": "off",
    "binaries": "off",
    "unresolved": "off",
    "duplicates": "off",
  },
  "ignoreExportsUsedInFile": true,
  "ignore": ["src/components/ui/**"],
}
